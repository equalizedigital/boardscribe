# Directories that must never ship in a release/SVN payload.
# The canonical allowlist is package.json's "files" field, used by
# `npm run dist` (scripts/dist.sh); this file is the matching denylist for
# wp dist-archive or any other tooling that packages by exclusion. Keep the
# two in step - a path added to one usually needs the other updating too.
.claude
.git
.github
.husky
dist
docs
node_modules
scripts
src
tests
vendor/bin

# Client data — never ship, tracked or not
*.csv

# Dev/config files
# (composer.json is NOT listed here — it ships, because vendor/ ships and
# Plugin Check flags missing_composer_json_file without it.)
#
# src/, webpack.config.js and package.json stay excluded: WP.org guideline 4
# is satisfied by the public github.com/equalizedigital/boardscribe repo,
# which readme.txt links along with the build steps. If that repo ever goes
# private again, the source and build tooling have to ship in the zip instead.
.distignore
.editorconfig
.eslintrc
.gitignore
.phpunit.result.cache
CLAUDE.md
README.md
composer.lock
docker-compose.yml
package.json
package-lock.json
phpcs.xml
phpunit.dev.xml
phpunit.xml.dist
webpack.config.js
