# Directories that must never ship in a release/SVN payload.
# The canonical zip recipe lives in .claude/skills/package-plugins/SKILL.md
# (an allowlist); this file is the matching denylist for wp dist-archive
# or any other tooling that packages by exclusion.
.claude
.git
.github
.husky
dist
docs
node_modules
scripts
src
tests
vendor/bin

# Dev/config files
.distignore
.editorconfig
.eslintrc
.gitignore
.phpunit.result.cache
CLAUDE.md
README.md
composer.json
composer.lock
docker-compose.yml
package.json
package-lock.json
phpcs.xml
phpunit.dev.xml
phpunit.xml.dist
webpack.config.js
