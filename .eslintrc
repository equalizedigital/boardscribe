{
	"extends": [ "plugin:@wordpress/eslint-plugin/esnext" ],
	"env": {
		"browser": true,
		"node": false
	},
	"globals": {
		"wp": true,
		"jQuery": true
	},
	"overrides": [
		{
			"files": [ "src/js/block/**/*.js", "src/js/block/**/*.jsx" ],
			"plugins": [ "react" ],
			"parserOptions": {
				"ecmaVersion": 2021,
				"sourceType": "module",
				"ecmaFeatures": {
					"jsx": true
				}
			},
			"rules": {
				"react/jsx-uses-vars": "error"
			}
		}
	]
}
