#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Објавите приступачне дневне редове и записнике са седница који се могу претраживати на вашем веб-сајту — направљено за јавне органе, скупштине станара и непрофитне организације којима су потребни отворени и организовани записи."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe захтева PHP %1$s или новији. Тренутно користите PHP %2$s. Надоградите PHP или контактирајте свог добављача хостинга."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe-у недостаје аутоматски учитавач (autoloader). Поново инсталирајте из званичне zip архиве или покрените „composer install“ ако развијате из изворног кода."

