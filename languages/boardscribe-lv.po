#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publicējiet piekļūstamas, meklējamas sēžu darba kārtības un protokolus savā vietnē — izstrādāts valsts iestādēm, dzīvokļu īpašnieku biedrībām un bezpeļņas organizācijām, kurām nepieciešami atklāti, sakārtoti ieraksti."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe nepieciešama PHP versija %1$s vai jaunāka. Jūs izmantojat PHP %2$s. Lūdzu, atjauniniet PHP vai sazinieties ar savu pakalpojumu sniedzēju."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe trūkst automātiskās ielādes faila (autoloader). Instalējiet atkārtoti no oficiālā zip arhīva vai palaidiet “composer install”, ja veicat izstrādi no pirmkoda."

