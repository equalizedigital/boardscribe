#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "अपनी साइट पर सुलभ, खोजने योग्य बैठक कार्यसूचियां और कार्यवृत्त प्रकाशित करें — यह उन सार्वजनिक निकायों, गैर-लाभकारी संस्थाओं और HOAs के लिए बनाया गया है जिन्हें खुले, व्यवस्थित रिकॉर्ड की आवश्यकता है।"

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe के लिए PHP %1$s या उससे उच्च संस्करण की आवश्यकता है। आप PHP %2$s चला रहे हैं। कृपया PHP को अपग्रेड करें या अपने होस्ट से संपर्क करें।"

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe का ऑटोलोडर (autoloader) गायब है। जारी किए गए ज़िप (zip) से पुन: इंस्टॉल करें, या यदि स्रोत से विकसित कर रहे हैं तो `composer install` चलाएं।"

