#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publiez des ordres du jour et des procès-verbaux de réunion accessibles et consultables sur votre site — conçu pour les organismes publics, les associations de copropriétaires et les organismes à but non lucratif ayant besoin de registres ouverts et organisés."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe nécessite PHP %1$s ou une version supérieure. Vous utilisez PHP %2$s. Veuillez mettre à jour PHP ou contacter votre hébergeur."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe ne trouve pas son autochargeur. Réinstallez l'extension à partir d'un fichier zip officiel, ou lancez « composer install » si vous développez à partir des sources."

