msgid "A meeting needs a valid meeting date (YYYY-MM-DD) before it can be published."
msgstr "Μια συνεδρίαση χρειάζεται έγκυρη ημερομηνία συνεδρίασης (YYYY-MM-DD) για να μπορέσει να δημοσιευτεί."

#: includes/Admin/MeetingDateGuard.php:162
msgid "The meeting was saved as a draft because it has no meeting date. Add a date, then publish it."
msgstr "Η συνεδρίαση αποθηκεύτηκε ως προσχέδιο επειδή δεν έχει οριστεί ημερομηνία συνεδρίασης. Προσθέστε ημερομηνία και, στη συνέχεια, δημοσιεύστε την."

#. translators: %d: number of meetings.
#: includes/Admin/MeetingDateGuard.php:178
#, php-format
msgid "%d published meeting has no valid meeting date. Add a date to it."
msgid_plural "%d published meetings have no valid meeting date. Add a date to each."
msgstr[0] "%d δημοσιευμένη συνεδρίαση δεν έχει έγκυρη ημερομηνία συνεδρίασης. Προσθέστε μια ημερομηνία σε αυτή."
msgstr[1] "%d δημοσιευμένες συνεδριάσεις δεν έχουν έγκυρη ημερομηνία συνεδρίασης. Προσθέστε μια ημερομηνία σε κάθε μία."

