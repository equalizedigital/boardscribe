#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Δημοσιεύστε προσβάσιμες και αναζητήσιμες ημερήσιες διατάξεις και πρακτικά συνεδριάσεων στον ιστότοπό σας — σχεδιασμένο για δημόσιους φορείς, ενώσεις ιδιοκτητών και μη κερδοσκοπικούς οργανισμούς που χρειάζονται ανοιχτά, οργανωμένα αρχεία."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "Το BoardScribe απαιτεί PHP %1$s ή μεταγενέστερη έκδοση. Χρησιμοποιείτε την PHP %2$s. Παρακαλούμε αναβαθμίστε την PHP ή επικοινωνήστε με τον πάροχο φιλοξενίας σας."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Λείπει το autoloader του BoardScribe. Επανεγκαταστήστε το από ένα επίσημο αρχείο zip ή εκτελέστε την εντολή `composer install` εάν κάνετε ανάπτυξη από τον πηγαίο κώδικα."

