#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Veröffentlichen Sie barrierefreie, durchsuchbare Sitzungstagesordnungen und Protokolle auf Ihrer Website – entwickelt für öffentliche Einrichtungen, Hausverwaltungen und gemeinnützige Organisationen, die offene, organisierte Aufzeichnungen benötigen."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe erfordert PHP %1$s oder höher. Sie verwenden PHP %2$s. Bitte aktualisieren Sie PHP oder kontaktieren Sie Ihren Host."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Der Autoloader von BoardScribe fehlt. Installieren Sie das Plugin aus einer veröffentlichten ZIP-Datei neu oder führen Sie „composer install“ aus, wenn Sie aus dem Quellcode entwickeln."

