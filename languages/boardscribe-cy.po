msgstr "Mewnforio wedi'i gwblhau. %1$d rhes wedi'u mewnforio, %2$d wedi'u hepgor."

#. translators: %d: number of rows scheduled for a future date
#: includes/Import/CsvImporter.php:749
#, php-format
msgid "%d row was scheduled for a future date and will not appear until then."
msgid_plural "%d rows were scheduled for a future date and will not appear until then."
msgstr[0] "Trefnwyd %d rhes ar gyfer dyddiad yn y dyfodol ac ni fydd yn ymddangos tan hynny."
msgstr[1] "Trefnwyd %d res ar gyfer dyddiad yn y dyfodol ac ni fyddant yn ymddangos tan hynny."
msgstr[2] "Trefnwyd %d o resi ar gyfer dyddiad yn y dyfodol ac ni fyddant yn ymddangos tan hynny."
msgstr[3] "Trefnwyd %d rhes ar gyfer dyddiad yn y dyfodol ac ni fyddant yn ymddangos tan hynny."

#. translators: %d: number of duplicate rows skipped
#: includes/Import/CsvImporter.php:757
#, php-format
msgid "%d row matched an existing meeting, or an earlier row in this file, with the same title and date, and a matching or absent start time, and was skipped."
msgid_plural "%d rows matched an existing meeting, or an earlier row in this file, with the same title and date, and a matching or absent start time, and were skipped."
msgstr[0] "Roedd %d rhes yn cyfateb i gyfarfod presennol, neu res gynharach yn y ffeil hon, gyda'r un teitl a dyddiad, ac amser dechrau sy'n cyfateb neu'n absennol, a chafodd ei hepgor."
msgstr[1] "Roedd %d res yn cyfateb i gyfarfod presennol, neu res gynharach yn y ffeil hon, gyda'r un teitl a dyddiad, ac amser dechrau sy'n cyfateb neu'n absennol, a chawsant eu hepgor."
msgstr[2] "Roedd %d o resi yn cyfateb i gyfarfod presennol, neu res gynharach yn y ffeil hon, gyda'r un teitl a dyddiad, ac amser dechrau sy'n cyfateb neu'n absennol, a chawsant eu hepgor."
msgstr[3] "Roedd %d rhes yn cyfateb i gyfarfod presennol, neu res gynharach yn y ffeil hon, gyda'r un teitl a dyddiad, ac amser dechrau sy'n cyfateb neu'n absennol, a chawsant eu hepgor."

#. translators: %d: number of rows with an invalid URL column
#: includes/Import/CsvImporter.php:765
#, php-format
msgid "%d row had an invalid URL; that URL was not saved."
msgid_plural "%d rows had an invalid URL; those URLs were not saved."
msgstr[0] "Roedd gan %d rhes URL annilys; ni arbrir yr URL hwnnw."
msgstr[1] "Roedd gan %d res URL annilys; ni arbrir yr URLau hynny."
msgstr[2] "Roedd gan %d o resi URL annilys; ni arbrir yr URLau hynny."
msgstr[3] "Roedd gan %d rhes URL annilys; ni arbrir yr URLau hynny."

#. translators: %d: number of rows with a start or end time that could not be read
#: includes/Import/CsvImporter.php:773
#, php-format
msgid "%d row had a start or end time that could not be read; that time was not saved."
msgid_plural "%d rows had a start or end time that could not be read; those times were not saved."
msgstr[0] "Roedd gan %d rhes amser dechrau neu ddiwedd na ellid ei ddarllen; ni arbrir yr amser hwnnw."
msgstr[1] "Roedd gan %d res amser dechrau neu ddiwedd na ellid ei ddarllen; ni arbrir yr amserau hynny."
msgstr[2] "Roedd gan %d o resi amser dechrau neu ddiwedd na ellid ei ddarllen; ni arbrir yr amserau hynny."
msgstr[3] "Roedd gan %d rhes amser dechrau neu ddiwedd na ellid ei ddarllen; ni arbrir yr amserau hynny."

