#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Публикувайте достъпни и лесни за търсене дневни редове и протоколи от заседания на Вашия сайт — създаден за публични органи, сдружения на собствениците и организации с нестопанска цел, които се нуждаят от открити и организирани записи."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe изисква PHP %1$s или по-нова версия. Вие използвате PHP %2$s. Моля, надстройте PHP или се свържете с Вашия хостинг доставчик."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Липсва автозаредителят на BoardScribe. Инсталирайте отново от официален zip архив или изпълнете `composer install`, ако разработвате от изходен код."

