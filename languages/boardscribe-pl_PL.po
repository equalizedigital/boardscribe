#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publikuj dostępne i łatwe do przeszukiwania porządki obrad oraz protokoły z posiedzeń w swojej witrynie — rozwiązanie stworzone dla podmiotów publicznych, wspólnot mieszkaniowych i organizacji non-profit, które potrzebują jawnych i uporządkowanych rejestrów."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe wymaga PHP w wersji %1$s lub nowszej. Twoja wersja PHP to %2$s. Zaktualizuj PHP lub skontaktuj się z dostawcą hostingu."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Brakuje autoloadera wtyczki BoardScribe. Zainstaluj ją ponownie z oficjalnego pliku zip lub uruchom „composer install”, jeśli pracujesz na kodzie źródłowym."

