#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Mag-publish ng naa-access at naha-hanap na mga adyenda at katitikan ng pagpupulong sa iyong site — binuo para sa mga pampublikong lupon, HOA, at mga nonprofit na nangangailangan ng bukas at organisadong mga tala."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "Ang BoardScribe ay nangangailangan ng PHP %1$s o mas mataas pa. Kasalukuyan kang gumagamit ng PHP %2$s. Pakisuyong i-upgrade ang PHP o makipag-ugnayan sa iyong host."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Nawawala ang autoloader ng BoardScribe. I-reinstall mula sa isang released zip, o i-run ang `composer install` kung nagde-develop mula sa source."

