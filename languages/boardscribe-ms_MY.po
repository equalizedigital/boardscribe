#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Terbitkan agenda dan minit mesyuarat yang boleh dicapai serta boleh dicari di tapak anda — dibina untuk badan awam, HOA dan pertubuhan bukan untung yang memerlukan rekod terbuka dan teratur."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe memerlukan PHP %1$s atau lebih tinggi. Anda sedang menjalankan PHP %2$s. Sila naik taraf PHP atau hubungi pengehos anda."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe kehilangan pemuat automatiknya. Pasang semula daripada zip yang dikeluarkan, atau jalankan `composer install` jika membangun daripada sumber."

