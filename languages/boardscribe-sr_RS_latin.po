#: includes/Shortcode/FieldRegistry.php:235
msgid "Display Template"
msgstr "Šablon prikaza"

#: includes/Shortcode/FieldRegistry.php:243
msgid "Table (default)"
msgstr "Tabela (podrazumevano)"

#: includes/Shortcode/FieldRegistry.php:248
msgid "One table row per meeting, with the columns you choose below."
msgstr "Jedan red tabele po sastanku, sa kolonama koje izaberete ispod."

#: includes/Shortcode/FieldRegistry.php:255
msgid "Force all columns to the same width"
msgstr "Primoraj sve kolone na istu širinu"

#: includes/Shortcode/FieldRegistry.php:257
msgid "Helps align columns consistently for vertical rhythm across rows."
msgstr "Pomaže u doslednom poravnanju kolona radi vertikalnog ritma kroz redove."

#: includes/Shortcode/FieldRegistry.php:263
