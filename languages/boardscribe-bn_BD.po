#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "আপনার সাইটে অ্যাক্সেসযোগ্য এবং অনুসন্ধানযোগ্য মিটিং আলোচ্যসূচি এবং কার্যবিবরণী প্রকাশ করুন — এটি সেইসব পাবলিক বডি, HOA এবং অলাভজনক প্রতিষ্ঠানের জন্য তৈরি করা হয়েছে যাদের উন্মুক্ত ও সুসংগঠিত রেকর্ডের প্রয়োজন।"

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe-এর জন্য PHP %1$s বা তার উচ্চতর সংস্করণ প্রয়োজন। আপনি PHP %2$s ব্যবহার করছেন। অনুগ্রহ করে PHP আপগ্রেড করুন অথবা আপনার হোস্টের সাথে যোগাযোগ করুন।"

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe-এর অটোলোডার (autoloader) পাওয়া যাচ্ছে না। রিলিজ করা জিপ (zip) ফাইল থেকে পুনরায় ইনস্টল করুন, অথবা সোর্স থেকে ডেভেলপ করলে `composer install` রান করুন।"

