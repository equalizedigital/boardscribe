#: includes/Admin/MeetingDateGuard.php:107
msgid "A meeting needs a valid meeting date (YYYY-MM-DD) before it can be published."
msgstr "একটি মিটিং প্রকাশ করার পূর্বে একটি বৈধ মিটিং তারিখ (YYYY-MM-DD) থাকা প্রয়োজন।"

#: includes/Admin/MeetingDateGuard.php:162
msgid "The meeting was saved as a draft because it has no meeting date. Add a date, then publish it."
msgstr "মিটিংটিতে কোনো মিটিং তারিখ না থাকায় এটি ড্রাফট হিসেবে সংরক্ষণ করা হয়েছে। একটি তারিখ যোগ করুন, তারপর এটি প্রকাশ করুন।"

#. translators: %d: number of meetings.
#: includes/Admin/MeetingDateGuard.php:178
#, php-format
msgid "%d published meeting has no valid meeting date. Add a date to it."
msgid_plural "%d published meetings have no valid meeting date. Add a date to each."
msgstr[0] "%d টি প্রকাশিত মিটিংয়ে কোনো বৈধ মিটিং তারিখ নেই। এটিতে একটি তারিখ যোগ করুন।"
msgstr[1] "%d টি প্রকাশিত মিটিংয়ে কোনো বৈধ মিটিং তারিখ নেই। প্রতিটিতে একটি তারিখ যোগ করুন।"

