#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publique ordens de trabalhos e atas de reuniões acessíveis e pesquisáveis no seu site — criado para organismos públicos, associações de moradores e organizações sem fins lucrativos que necessitam de registos abertos e organizados."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "O BoardScribe requer o PHP %1$s ou superior. Está a utilizar o PHP %2$s. Atualize o PHP ou contacte o seu fornecedor de alojamento."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "O BoardScribe não encontra o seu autoloader. Reinstale a partir de um ficheiro zip oficial ou execute `composer install` se estiver a desenvolver a partir do código-fonte."

