#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Zverejňujte prístupné a vyhľadávateľné programy a zápisnice zo zasadnutí na svojej stránke – vytvorené pre verejné orgány, spoločenstvá vlastníkov bytov a neziskové organizácie, ktoré potrebujú otvorené a organizované záznamy."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe vyžaduje PHP %1$s alebo vyššiu verziu. Používate PHP %2$s. Prosím, aktualizujte verziu PHP alebo kontaktujte svojho poskytovateľa hostingu."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Pluginu BoardScribe chýba autoloader. Preinštalujte ho z vydaného súboru zip alebo spustite „composer install“, ak vyvíjate zo zdrojového kódu."

