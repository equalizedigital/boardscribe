#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publicați ordinea de zi și procesele-verbale ale ședințelor într-un format accesibil și ușor de parcurs — creat pentru organisme publice, asociații de proprietari și organizații nonprofit care au nevoie de înregistrări deschise și organizate."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe necesită PHP %1$s sau o versiune ulterioară. Dumneavoastră utilizați PHP %2$s. Vă rugăm să actualizați versiunea PHP sau să contactați furnizorul de găzduire."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Lipsește fișierul de autoîncărcare (autoloader) al BoardScribe. Reinstalați dintr-o arhivă zip oficială sau rulați „composer install” dacă dezvoltați folosind codul sursă."

