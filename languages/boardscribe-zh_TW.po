#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "在您的網站上發佈無障礙且可搜尋的會議議程與會議紀錄 — 專為需要公開、有條理記錄的公共機構、業主協會和非營利組織而設計。"

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe 需要 PHP %1$s 或更高版本。您目前執行的版本為 PHP %2$s。請升級 PHP 或聯繫您的主機商。"

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe 遺失自動載入器 (autoloader)。請從發佈的 zip 檔案重新安裝，或如果是從原始碼開發，請執行 `composer install`。"

