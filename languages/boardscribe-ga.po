#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Foilsigh cláir oibre agus miontuairiscí cruinnithe atá inrochtana agus inchuardaithe ar do shuíomh — tógtha do chomhlachtaí poiblí, HOAanna, agus eagraíochtaí neamhbhrabúis a bhfuil taifid oscailte eagraithe de dhíth orthu."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "Tá PHP %1$s nó níos airde de dhíth ar BoardScribe. Tá PHP %2$s á rith agat. Uasghrádaigh PHP le do thoil nó déan teagmháil le d’óstach."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Tá uathlódóir BoardScribe in easnamh. Athshuiteáil ó chomhad zip eisithe é, nó rith `composer install` má tá tú á fhorbairt ón bhfoinse."

