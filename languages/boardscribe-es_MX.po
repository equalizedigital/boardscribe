#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Publique órdenes del día y actas de reuniones accesibles y con opción de búsqueda en su sitio; diseñado para organismos públicos, asociaciones de propietarios y organizaciones sin fines de lucro que necesitan registros abiertos y organizados."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe requiere PHP %1$s o superior. Usted está ejecutando PHP %2$s. Por favor, actualice PHP o contacte a su proveedor de hosting."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Falta el autoloader de BoardScribe. Reinstale desde un archivo zip oficial o ejecute `composer install` si está realizando el desarrollo desde el código fuente."

