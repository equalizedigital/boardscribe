#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Skelbkite prieinamas, lengvai randamas posėdžių darbotvarkes ir protokolus savo svetainėje – sukurta viešosioms įstaigoms, bendrijoms ir ne pelno siekiančioms organizacijoms, kurioms reikalingi atviri, organizuoti įrašai."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "„BoardScribe“ reikalinga PHP %1$s arba naujesnė versija. Jūs naudojate PHP %2$s. Prašome atnaujinti PHP arba susisiekti su savo paslaugų teikėju."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "Trūksta „BoardScribe“ automatinio įkėlimo failo. Įdiekite iš naujo iš išleisto ZIP archyvo arba paleiskite „composer install“, jei kuriate iš pradinio kodo."

