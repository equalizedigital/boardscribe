#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Avaldage oma saidil ligipääsetavaid ja otsitavaid koosolekute päevakordi ning protokolle – loodud avalik-õiguslikele asutustele, korteriühistutele ja mittetulundusühingutele, kes vajavad avatud ja organiseeritud dokumentatsiooni."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "BoardScribe vajab PHP versiooni %1$s või uuemat. Teie kasutate PHP versiooni %2$s. Palun uuendage PHP-d või võtke ühendust oma teenusepakkujaga."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "BoardScribe'i automaatlaadija on puudu. Installige uuesti ametlikust zip-failist või käivitage „composer install“, kui arendate lähtekoodist."

