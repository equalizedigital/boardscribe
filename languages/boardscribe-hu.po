#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:79
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Tegye közzé webhelyén akadálymentes, kereshető formában a vezetőségi ülések napirendjeit és jegyzőkönyveit – olyan köztestületek, lakásszövetkezetek és nonprofit szervezetek számára készült, amelyeknek nyitott, rendszerezett nyilvántartásra van szükségük."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "A BoardScribe futtatásához legalább %1$s verziójú PHP szükséges. Jelenleg a PHP %2$s verzióját használja. Kérjük, frissítse a PHP-t, vagy vegye fel a kapcsolatot a tárhelyszolgáltatójával."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "A BoardScribe automatikus betöltője (autoloader) hiányzik. Telepítse újra a hivatalos zip fájlból, vagy futtassa a `composer install` parancsot, ha forráskódból fejleszti."

