#. Plugin Name of the plugin
#: boardscribe.php
#: includes/Block/BoardScribeBlock.php:145
#: partials/settings-page.php:22
msgid "BoardScribe"
msgstr "BoardScribe"

#. Description of the plugin
#: boardscribe.php
msgid "Publish accessible, searchable meeting agendas and minutes on your site — built for public bodies, HOAs, and nonprofits that need open, organized records."
msgstr "Публикуйте доступные и удобные для поиска повестки дня и протоколы заседаний на своем сайте — создано для государственных органов, ТСЖ и некоммерческих организаций, которым нужны открытые и систематизированные записи."

#. Author of the plugin
#: boardscribe.php
msgid "Equalize Digital"
msgstr "Equalize Digital"

#. Author URI of the plugin
#: boardscribe.php
msgid "https://equalizedigital.com"
msgstr "https://equalizedigital.com"

#. translators: 1: required PHP version, 2: current PHP version
#: boardscribe.php:30
#, php-format
msgid "BoardScribe requires PHP %1$s or higher. You are running PHP %2$s. Please upgrade PHP or contact your host."
msgstr "Для работы BoardScribe требуется PHP версии %1$s или выше. Вы используете PHP %2$s. Пожалуйста, обновите PHP или обратитесь к вашему хостинг-провайдеру."

#: boardscribe.php:52
msgid "BoardScribe is missing its autoloader. Reinstall from a released zip, or run `composer install` if developing from source."
msgstr "В BoardScribe отсутствует автозагрузчик. Переустановите плагин из официального zip-архива или выполните команду `composer install`, если вы ведете разработку из исходного кода."

