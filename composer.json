{
    "name": "equalizedigital/boardscribe",
    "description": "Equalize Digital BoardScribe WordPress Plugin",
    "license": "GPL-2.0-or-later",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "EqualizeDigital\\BoardScribe\\": "includes/"
        }
    },
    "require-dev": {
        "automattic/vipwpcs": "^3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
        "doctrine/instantiator": "^1.3.1",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpcompatibility/php-compatibility": "*",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^1.1.0",
        "yoast/wp-test-utils": "^1.2"
    },
    "scripts": {
        "lint": [
            "@php ./vendor/php-parallel-lint/php-parallel-lint/parallel-lint . -e php --show-deprecated --exclude vendor --exclude node_modules --exclude .git --exclude build"
        ],
        "check-cs": [
            "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs"
        ],
        "fix-cs": [
            "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf"
        ],
        "test": [
            "@php ./vendor/phpunit/phpunit/phpunit --testdox"
        ],
        "generate-hooks-docs": [
            "@php tools/generate-hooks-docs.php"
        ]
    }
}
