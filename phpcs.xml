<?xml version="1.0"?>
<ruleset name="Meeting Minutes">
    <description>WordPress coding standards for the Meeting Minutes plugin.</description>

    <!-- Files to check -->
    <file>.</file>

    <!-- Only check PHP; JS/CSS have their own dedicated linters (wp-scripts lint-js, etc.) -->
    <arg name="extensions" value="php"/>

    <!-- Exclude non-PHP directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Generated build artifacts (webpack bundle output) -->
    <exclude-pattern>*/assets/build/*</exclude-pattern>

    <!-- Use WordPress coding standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- includes/ uses namespaced, PSR-4-style class files, not the legacy class-*.php convention -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/includes/*</exclude-pattern>
    </rule>

    <!-- Require PHP 7.4+ -->
    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <!-- Plugin-specific text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="meeting-minutes"/>
            </property>
        </properties>
    </rule>

    <!-- Everything in the global namespace (variables in root-scope files, constants,
         hooks) must carry the plugin prefix — Plugin Check enforces this too -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="edmm"/>
                <element value="EqualizeDigital\MeetingMinutes"/>
            </property>
        </properties>
    </rule>
</ruleset>
